GHCR_OWNER=your-github-owner
AUTH_IMAGE_TAG=sha-replace-with-commit
AUTH_POSTGRES_PASSWORD=replace-with-random-password
# URL-encode reserved characters in the password; private Docker network only.
AUTH_DATABASE_URL=postgres://flowdraw_auth:replace-with-random-password@auth-postgres:5432/auth_db?sslmode=disable
AUTH_GLOBAL_SECRET=
AUTH_SIGNING_KEY_ID=auth-2026-09
AUTH_KEYS_DIRECTORY=/opt/secrets/flowdraw-auth
# Optional public JWKS containing previous keys; file inside the mounted directory.
AUTH_OVERLAP_JWKS_FILE=
RESEND_API_KEY=
EMAIL_FROM=accounts@auth.k1n3ticnerdcore.tech
EMAIL_FROM_NAME=Flowdraw Auth
FLOWDRAW_CALLBACK_URL=https://flowdraw.example.com/api/auth/callback
FLOWDRAW_CLIENT_SECRET=
