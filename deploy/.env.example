# GitHub/GHCR account or organization, lowercase.
GHCR_OWNER=your-github-username

# Use an immutable image produced by GitHub Actions.
IMAGE_TAG=sha-change-me

# Generate independent values, for example with: openssl rand -base64 32
POSTGRES_PASSWORD=change-to-a-long-random-value
MINIO_ROOT_USER=change-to-a-random-access-key
MINIO_ROOT_PASSWORD=change-to-a-long-random-secret

# Bucket-scoped identity used only by flowdraw-api. Do not reuse the root values.
FLOWDRAW_S3_ACCESS_KEY=change-to-a-dedicated-access-key
FLOWDRAW_S3_SECRET_KEY=change-to-a-dedicated-secret-key

# Optional OIDC integration. Set all four to enable backend-owned login sessions.
FLOWDRAW_AUTH_ISSUER=
# When enabling: https://auth.k1n3ticnerdcore.tech
FLOWDRAW_PUBLIC_URL=
# When enabling: https://your-deployed-flowdraw-host
FLOWDRAW_CLIENT_SECRET=
# openssl rand -base64 32; encrypts temporary OIDC login handoffs in flowdraw_db.
FLOWDRAW_SESSION_KEY=
