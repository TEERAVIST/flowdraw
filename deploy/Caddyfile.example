# This file belongs to the shared gateway at /opt/apps/gateway/Caddyfile.
# Cloudflare proxies this hostname; Caddy remains the only origin ingress.
{$FLOWDRAW_HOSTNAME} {
    handle /api/* {
        reverse_proxy flowdraw-api:3000
    }

    handle /ws {
        reverse_proxy flowdraw-api:3000
    }

    handle {
        reverse_proxy flowdraw:80
    }
}
