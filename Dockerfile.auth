# syntax=docker/dockerfile:1.7
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY auth-service/go.mod auth-service/go.sum ./
RUN go mod download
COPY auth-service/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/auth ./cmd/auth

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && addgroup -g 10001 auth && adduser -D -H -u 10001 -G auth auth
COPY --from=build /out/auth /usr/local/bin/auth
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["auth", "health-ready"]
ENTRYPOINT ["auth"]
CMD ["serve"]
