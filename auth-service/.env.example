AUTH_ADDRESS=:8080
AUTH_DATABASE_URL=postgres://flowdraw_auth:change-me@auth-postgres:5432/auth_db?sslmode=disable
AUTH_ISSUER=https://auth.example.com
AUTH_PUBLIC_URL=https://auth.example.com
AUTH_COOKIE_SECURE=true
AUTH_SIGNING_KEY_FILE=/run/secrets/auth_signing_key
AUTH_SIGNING_KEY_ID=replace-with-stable-kid

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=auth@auth.example.com
EMAIL_FROM_NAME=Flowdraw Auth

# openssl rand -base64 32; keep stable across restarts.
AUTH_GLOBAL_SECRET=
# Optional JWKS file containing previous RSA public keys, each with a distinct kid.
AUTH_OVERLAP_JWKS_FILE=
FLOWDRAW_CALLBACK_URL=https://flowdraw.example.com/api/auth/callback
FLOWDRAW_CLIENT_SECRET=
# Integration tests ONLY: disposable database; tests recreate its public schema.
AUTH_TEST_DATABASE_URL=
